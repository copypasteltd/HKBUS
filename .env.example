HOST=127.0.0.1
PORT=4100
DATABASE_PATH=./data/hkbusgo.db
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
PROVIDER_MODE=live
CORS_ORIGINS=*
TRUSTED_PROXIES=
RATE_LIMIT_MAX=120
PUBLIC_APP_URL=http://localhost:10086
KMB_BASE_URL=https://data.etabus.gov.hk/v1/transport/kmb
TDAS_BASE_URL=https://tdas-api.hkemobility.gov.hk/tdas/api/route
TDAS_ENABLED=true
# Optional authenticated TDAS-only egress when this host cannot reach the official API.
# Configure both values on the backend only. Never put the secret in any client build.
TDAS_EGRESS_URL=
TDAS_EGRESS_SECRET=
PROVIDER_TIMEOUT_MS=15000
CATALOG_SYNC_HOURS=24
