{
  "name": "@hkbusgo/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env.local dist/main.js",
    "test": "tsx --test test/*.test.ts && node --test deploy/tdas-egress/test/route.test.mjs",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "backup": "tsx --env-file-if-exists=.env.local scripts/backup.ts",
    "typecheck": "tsc --noEmit",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "sync:live": "tsx --env-file-if-exists=.env.local scripts/sync-live.ts",
    "openapi": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "fastify": "^5.6.0",
    "proj4": "2.22.0",
    "saxes": "6.0.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
